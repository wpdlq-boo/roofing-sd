# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Public site address (used for sitemap.xml, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Resend (server-only secrets — never prefix these with NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Inbox that receives quote requests.
QUOTE_ADMIN_EMAIL=owner@example.com
# Sender on your verified Resend domain, e.g. website@yourdomain.ca
QUOTE_FROM_EMAIL=website@yourdomain.ca

# Any long random string. Vercel sends it to /api/keep-alive (AVL-04).
CRON_SECRET=replace-with-a-long-random-string
